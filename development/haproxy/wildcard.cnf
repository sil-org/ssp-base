[req]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = req_ext

[dn]
C  = US
ST = NC
L  = Waxhaw
O  = SIL Global
CN = *.local

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = *.local
DNS.2 = ssp-hub.local
DNS.3 = ssp-sp1.local
DNS.4 = ssp-sp2.local
DNS.5 = ssp-sp3.local
DNS.6 = ssp-idp1.local
DNS.7 = ssp-idp2.local
DNS.8 = ssp-idp3.local
DNS.9 = ssp-idp4.local
DNS.10 = pwmanager.local
