<!DOCTYPE html>
<html lang="{{ currentLanguage }}">
<head>
  <title>{{ '{expired:title}'|trans }}</title>

  {{ include('header.twig') }}
</head>
<body class="gradient-bg d-flex flex-column min-vh-100">
<div class="bootstrap-layout container-fluid p-0 d-flex flex-column flex-grow-1 min-vh-100">
  <header class="navbar navbar-expand-lg bg-danger navbar-dark px-3 py-2 shadow-sm">
    <div class="container-fluid">
      <span class="navbar-brand mb-0 h1 text-wrap me-auto">
        {{ '{expired:header}'|trans }}
      </span>
    </div>
  </header>

  <main class="container d-flex flex-column align-items-center justify-content-center flex-grow-1 my-auto py-4">
    <form method="post" class="w-100 d-flex justify-content-center">
      {% for name, value in form_data %}
        <input type="hidden" name="{{ name|e }}" value="{{ value|e }}">
      {% endfor %}

      <div class="card idp-card shadow-lg border-0 rounded-3">
        <div class="card-header bg-white text-center border-0 pt-4 pb-2">
          <i class="material-icons text-danger display-1" style="font-size: 3rem;">error</i>
          <h1 class="h3 card-title text-body mt-3 mb-1">
            {{ '{expired:header}'|trans }}
          </h1>
        </div>

        <div class="card-body p-4 text-center">
          <p class="h5 card-text text-body mb-0">
            {{ '{expired:expired}'|trans }}
          </p>
        </div>

        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-end align-items-center p-3">
          <button name="changepwd" type="submit" class="btn btn-primary">
            {{ '{expired:button_change}'|trans }}
          </button>
        </div>
      </div>
    </form>
  </main>

  <div class="d-none d-sm-block">
    {{ include('footer.twig') }}
  </div>
</div>
</body>
</html>

