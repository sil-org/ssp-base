<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll(".dropdown-item[data-callback]").forEach(function(item) {
      item.addEventListener('click', function(e) {
        e.preventDefault();
        location.href = item.dataset.callback;
      });
    });
  });
</script>

{% if other_options|length > 0 %}
  <div class="dropdown">
    <button id="others" type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
      <small>{{ '{mfa:use_others}'|trans }}</small>
    </button>
    <ul class="dropdown-menu shadow" aria-labelledby="others">
      {% for option in other_options %}
        <li>
          <a class="dropdown-item d-flex align-items-center py-2" href="#" data-callback="{{ option.callback|raw }}" id="more-options-{{ option.type }}">
            <img class="me-2" src="{{ option.image }}" width="20" height="20" {% set alt = '{mfa:' ~ option.type ~ '_icon}' %} alt="{{ alt|trans }}">
            {% set text = '{mfa:use_' ~ option.label ~ '}' %}
            <span>{{ text|trans }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

