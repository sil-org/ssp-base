<!DOCTYPE html>
<html lang="{{ currentLanguage }}">
<head>
  <title>{{ '{mfa:title}'|trans({'%idpName%': idp_name})  }}</title>

  {{ include('header.twig') }}
</head>
<body class="gradient-bg d-flex flex-column min-vh-100">
<div class="bootstrap-layout container-fluid p-0 d-flex flex-column flex-grow-1 min-vh-100">
  <main class="w-100 d-flex flex-column justify-content-center align-items-center flex-grow-1 my-auto">
    <form method="post" class="w-100 d-flex justify-content-center">
      <div class="card idp-card shadow-lg border-0 rounded-3">
        <div class="card-header bg-white text-center border-0 pt-4 pb-2">
          <i class="material-icons text-danger" style="font-size: 3rem;">error</i>
          <h1 class="h3 card-title text-body mt-3 mb-4">
            {{ '{mfa:header}'|trans({'%idpName%': idp_name}) }}
          </h1>
          <h1 class="h4 card-title text-body mb-1">
            {{ '{mfa:no_more_codes_header}'|trans }}
          </h1>
        </div>

        <div class="card-body p-4 text-center">
          <p class="card-text text-secondary mb-0">
            {% if has_other_mfa_options %}
              {{ '{mfa:has_options_besides_codes}'|trans }}
            {% else %}
              {{ '{mfa:has_no_more_options}'|trans }}
            {% endif %}
          </p>
        </div>

        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center p-3">
          {% if has_other_mfa_options %}
            <button name="continue" type="submit" class="btn btn-outline-secondary">
              {{ '{mfa:button_later}'|trans }}
            </button>
          {% endif %}

          <span class="flex-grow-1"></span>

          <button name="getMore" type="submit" class="btn btn-primary">
            {{ '{mfa:button_get_more}'|trans }}
          </button>
        </div>
      </div>
    </form>
  </main>

  <div class="d-none d-sm-block">
    {{ include('footer.twig') }}
  </div>
</div>
</body>
</html>

