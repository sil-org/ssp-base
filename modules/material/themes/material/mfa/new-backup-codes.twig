<!DOCTYPE html>
<html lang="{{ currentLanguage }}">
<head>
  <title>{{ '{mfa:title}'|trans({'%idpName%': idp_name})  }}</title>

  {{ include('header.twig') }}

  <script src="bowser.1.9.4.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      function disableUnsupportedFeatures() {
        if (bowser.msie) {
          disablePrint();
          disableDownload();
        }
      }

      function disablePrint() {
        const printBtn = document.querySelector('button#print');
        if (printBtn) {
          printBtn.disabled = true;
          printBtn.classList.add('not-allowed');
          printBtn.title = '{{ '{mfa:unsupported}'|trans|e('js')|raw }}';
        }
      }

      function disableDownload() {
        const downloadBtn = document.querySelector('a[download]');
        if (downloadBtn) {
          downloadBtn.href = '';
          downloadBtn.classList.add('disabled', 'not-allowed');
          downloadBtn.title = '{{ '{mfa:unsupported}'|trans|e('js')|raw }}';
        }
      }

      function copyCodesToClipboard(button) {
        const textarea = button.querySelector('textarea') || document.querySelector('textarea');
        if (textarea) {
          textarea.select();
          document.execCommand('copy');
        }

        button.innerHTML = button.innerHTML.replace(
          '{{ '{mfa:button_copy}'|trans }}',
          '{{ '{mfa:button_copied}'|trans }}'
        );
      }

      function printElement(selector) {
        let elementToPrint = document.querySelector(selector);

        elementToPrint.classList.add('printable-codes');

        window.print();
      }

      disableUnsupportedFeatures();

      const printBtn = document.getElementById('print');
      if (printBtn) {
        printBtn.addEventListener('click', function() {
          printElement('#code-card');
        });
      }
      const copyBtn = document.getElementById('copyBtn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function() {
          copyCodesToClipboard(this);
        });
      }
      const checkbox = document.getElementById('checkbox');
      if (checkbox) {
        checkbox.addEventListener('change', function(e) {
          const contBtn = document.getElementById('continue');
          if (contBtn) {
            contBtn.disabled = !e.target.checked;
          }
        });
      }
    });
  </script>
</head>
<body class="gradient-bg d-flex flex-column min-vh-100">
<div class="bootstrap-layout container-fluid p-0 p-sm-3 d-flex flex-column flex-grow-1 min-vh-100">
  <main class="w-100 d-flex flex-column justify-content-center align-items-center flex-grow-1 my-auto">
    <form method="post" class="w-100 d-flex flex-column align-items-center" style="max-width: 600px;">
      {% if new_backup_codes is not empty %}
        <h1 class="h3 text-center text-body mt-2 mb-4">
          {{ '{mfa:header}'|trans({'%idpName%': idp_name}) }}
        </h1>

        <h2 class="h4 text-center text-body mb-1">
          {{ '{mfa:new_codes_header}'|trans }}
        </h2>

        <p class="text-center text-secondary mb-2 mx-3">
          <em>{{ '{mfa:old_codes_gone}'|trans }}</em>
        </p>

        <p class="text-center text-secondary mb-3 mx-3">
          {{ '{mfa:new_codes_info}'|trans }}
          <span class="fw-bold">{{ '{mfa:new_codes_only_once}'|trans }}</span>
        </p>

        <div class="card shadow-lg border-0 rounded-3 w-100 mb-4" style="min-height: 17em">
          <div class="card-body p-4 text-center" id="code-card">
            <div class="code-container font-monospace mb-3 fs-5" style="column-count: 2; column-gap: 2rem;">
              {% for newCode in new_backup_codes %}
                <div class="py-1">☐ {{ newCode }}</div>
              {% endfor %}
            </div>

            <small class="text-secondary d-block mt-2">{{ '{mfa:new_codes_only_once}'|trans }}</small>
          </div>

          <div class="card-footer bg-transparent border-top-0 d-flex flex-wrap justify-content-center gap-2 p-3">
            <button
              class="btn btn-outline-primary"
              type="button"
              id="print"
            >
              {{ '{mfa:button_print}'|trans }}
            </button>

            <a
              href="data:text/plain,{{ codes_for_download }}"
              download="{{ idp_name }}-printable-codes.txt"
              class="btn btn-outline-primary"
            >
              {{ '{mfa:button_download}'|trans }}
            </a>

            <button id="copyBtn" class="btn btn-outline-primary" type="button">
              {{ '{mfa:button_copy}'|trans }}
              <textarea class="out-of-sight d-none">{{ codes_for_clipboard }}</textarea>
            </button>
          </div>
        </div>
      {% else %}
        <div class="card shadow-lg border-0 rounded-3 w-100 mb-4">
          <div class="card-header bg-white text-center border-0 pt-4 pb-2">
            <i class="material-icons text-danger display-1">error</i>
            <h1 class="h3 card-title text-body mt-3 mb-1">
              {{ '{error:header}'|trans }}
            </h1>
          </div>

          <div class="card-body p-4 text-center">
            <p class="card-text text-secondary">
              {{ '{mfa:new_codes_failed}'|trans }}
              <a href="{{ mfa_setup_url }}" target="_blank" rel="noopener">{{ mfa_setup_url }}</a>
            </p>
          </div>
        </div>

        {% if analytics_tracking_id is not empty %}
          <script>
            gtag('event', 'generation-failed', {
              'event_category': 'error',
              'event_label': 'backupcode'
            });
          </script>
        {% endif %}
      {% endif %}

      <div class="d-flex justify-content-between align-items-center w-100 gap-3">
        <div class="form-check me-auto">
          <input id="checkbox" type="checkbox" class="form-check-input me-2">
          <label class="form-check-label text-secondary small" for="checkbox">
            {{ '{mfa:new_codes_saved}'|trans }}
          </label>
        </div>

        <button name="continue" id="continue" type="submit" class="btn btn-primary" disabled>
          {{ '{mfa:button_continue}'|trans }}
        </button>
      </div>
    </form>
  </main>

  <div class="d-none d-sm-block">
    {{ include('footer.twig') }}
  </div>
</div>
</body>
</html>

