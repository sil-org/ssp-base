<!DOCTYPE html>
<html lang="{{ currentLanguage }}">
<head>
  <title>{{ '{mfa:title}'|trans({'%idpName%': idp_name})  }}</title>

  {{ include('header.twig') }}
  <style>
    .recovery-option {
      cursor: pointer;
      display: block;
    }
  </style>
</head>
<body class="gradient-bg d-flex flex-column min-vh-100">
<div class="bootstrap-layout container-fluid p-0  d-flex flex-column flex-grow-1 min-vh-100">
  <main class="w-100 d-flex flex-column justify-content-center align-items-center flex-grow-1 my-auto">
    <form method="post" autocomplete="off" class="w-100 d-flex justify-content-center">
      <div class="card idp-card shadow-lg border-0 rounded-3">
        <div class="card-header bg-white text-center border-0 pt-4 pb-2">
          <img src="/logo.png" alt="{{ '{login:logo}'|trans({'%idpName%': idp_name}) }}" class="img-fluid" style="max-width:150px;">
          <h1 class="h3 card-title text-body mt-3 mb-4">
            {{ '{mfa:header}'|trans({'%idpName%': idp_name}) }}
          </h1>
          <h1 class="h4 card-title text-body mb-1">
            {{ '{mfa:recovery_header}'|trans }}
          </h1>
          <p class="card-text text-secondary mb-0 mx-3">
            {{ '{mfa:recovery_info_introduction}'|trans }}
          </p>
        </div>

        <div class="card-body p-4">
          <p class="card-text text-secondary mb-3">
            {{ '{mfa:recovery_info_selection}'|trans }}
          </p>

          <div class="d-flex flex-column gap-2 mb-3">
            {% if masked_manager_email is not empty %}
              <div class="form-check text-start">
                <input class="form-check-input" type="radio" name="mfaRecoveryContactID" id="option-manager" value="recovery-contact-id-manager">
                <label class="form-check-label text-body" for="option-manager">
                  {{ '{mfa:recovery_your_supervisor}'|trans }} ({{ masked_manager_email }})
                </label>
              </div>
            {% endif %}

            {% for name in recovery_contacts_by_name|keys %}
              <div class="form-check text-start">
                <input class="form-check-input" type="radio" name="mfaRecoveryContactID" id="option-{{ loop.index }}" value="{{ name }}">
                <label class="form-check-label text-body" for="option-{{ loop.index }}">
                  {{ name }}
                </label>
              </div>
            {% endfor %}
          </div>

          {% if error_message is not empty %}
            <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
              <i class="material-icons me-2">error</i>
              <div>{{ error_message|e }}</div>
            </div>
          {% endif %}
        </div>

        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center p-3">
          <button name="cancel" type="submit" class="btn btn-outline-secondary">
            {{ '{mfa:button_cancel}'|trans }}
          </button>
          <span class="flex-grow-1"></span>

          <button name="send" type="submit" class="btn btn-primary">
            {{ '{mfa:button_send}'|trans }}
          </button>
        </div>
      </div>
    </form>
  </main>

  <div class="d-none d-sm-block">
    {{ include('footer.twig') }}
  </div>
</div>
</body>
</html>

