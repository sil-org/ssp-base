<!DOCTYPE html>
<html lang="{{ currentLanguage }}">
<head>
  <title>{{ '{mfa:title}'|trans({'%idpName%': idp_name})  }}</title>

  {{ include('header.twig') }}

  <script src="{{ remember_me_js_path }}"></script>
</head>
<body class="gradient-bg d-flex flex-column min-vh-100">
<div class="bootstrap-layout container-fluid p-0 p-sm-3 d-flex flex-column flex-grow-1 min-vh-100">
  <main class="w-100 d-flex flex-column justify-content-center align-items-center flex-grow-1 my-auto">
    <form method="post" autocomplete="off" class="w-100 d-flex justify-content-center">
      <div class="card idp-card shadow-lg border-0 rounded-3">
        <div class="card-header bg-white text-center border-0 pt-4 pb-2">
          <img src="/logo.png" alt="{{ '{login:logo}'|trans({'%idpName%': idp_name}) }}" class="img-fluid" style="max-width:150px;">
          <h1 class="h3 card-title text-body mt-3 mb-4">
            {{ '{mfa:header}'|trans({'%idpName%': idp_name}) }}
          </h1>
          <h2 class="h4 card-title text-body mb-1">
            {{ '{mfa:manager_header}'|trans }}
          </h2>
          <p class="card-text text-secondary mb-0 mx-3">
            {{ '{mfa:manager_sent}'|trans({'%maskedManagerEmail%': masked_manager_email}) }}
          </p>
        </div>

        <div class="card-body p-4">
          <div class="form-floating mb-3">
            <input
              name="mfaSubmission"
              class="form-control"
              autofocus
              id="mfaSubmission"
              autocomplete="off"
              data-1p-ignore
              placeholder="{{ '{mfa:manager_input}'|trans }}"
            >
            <label for="mfaSubmission">{{ '{mfa:manager_input}'|trans }}</label>
          </div>

          {% if error_message is not empty %}
            <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
              <i class="material-icons me-2">error</i>
              <div>{{ error_message|e }}</div>
            </div>

            {% if analytics_tracking_id is not empty %}
              <script>
                gtag('event', '{{ error_message|e('js')|raw }}', {
                  'event_category': 'error',
                  'event_label': 'managercode'
                });
              </script>
            {% endif %}
          {% endif %}

          <div class="form-check d-flex justify-content-center my-2">
            <input type="checkbox" id="rememberMe" name="rememberMe" checked class="form-check-input me-2">
            <label for="rememberMe" class="form-check-label text-secondary small">
              {{ '{mfa:remember_this}'|trans }}
            </label>
          </div>
        </div>

        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center p-3">
          {{ include('other_mfas.twig') }}

          <span class="flex-grow-1"></span>

          <button name="submitMfa" type="submit" class="btn btn-primary">
            {{ '{mfa:button_verify}'|trans }}
          </button>
        </div>
      </div>
    </form>
  </main>

  <div class="d-none d-sm-block">
    {{ include('footer.twig') }}
  </div>
</div>
</body>
</html>

