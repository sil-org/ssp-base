<!DOCTYPE html>
<html lang="{{ currentLanguage }}">
<head>
  <title>{{ '{login:title}'|trans({'%idpName%': idp_name}) }}</title>

  {{ include('header.twig') }}

  <script>
    function preventDefault(event) {
      event.preventDefault();
    }

    function togglePasswordVisibility() {
      const input = document.getElementById('password');
      const btn = document.getElementById('password-visibility-toggle');
      const icon = btn.querySelector('.material-icons');
      const isHidden = input.type === 'password';

      input.type = isHidden ? 'text' : 'password';
      icon.textContent = isHidden ? 'visibility_off' : 'visibility';
      btn.setAttribute('aria-label', isHidden ? '{{ '{login:hide_password}'|trans|e('js') }}' : '{{ '{login:show_password}'|trans|e('js') }}');
      btn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
    }

    function forgotPassword() {
      let url = '{{ password_forgot_url|e('js') }}';
      const username = document.getElementById('username').value;
      if (username) {
        const separator = url.includes('?') ? '&' : '?';
        url += separator + 'username=' + encodeURIComponent(username);
      }
      window.open(url, '_blank');
    }

    //Remove invalid input state on page load
    window.addEventListener('load', () => {
      const clean = () => {
        document.querySelectorAll('.mdl-textfield').forEach(el => {
          el.classList.remove('is-invalid');
        });
      };
      componentHandler.upgradeDom();
      setTimeout(clean, 0);
    });
  </script>

  {% if site_key is not empty %}
    <script src='https://www.google.com/recaptcha/api.js?onload=onRecaptchaLoad&render=explicit' async defer></script>

    <script>
      function submitForm() {
        document.querySelector('form').submit();
      }

      function onRecaptchaLoad() {
        var loginButton = document.querySelector('#submit-button');

        grecaptcha.render(loginButton, {
          sitekey: '{{ site_key|e('js')|raw }}',
          callback: submitForm
        });
      }

      {% if analytics_tracking_id is not empty %}
        gtag('event', 'required', {
          'event_category': 'reCAPTCHA'
        });
      {% endif %}
    </script>
  {% endif %}
</head>
<body class="gradient-bg d-flex flex-column">
<div class="bootstrap-layout container-fluid p-0 p-sm-3 d-flex flex-column flex-grow-1">
  <main class="w-100 d-flex flex-column justify-content-center align-items-center flex-grow-1 my-auto">
    {{ include('announcement.twig') }}

    <form method="post" autocomplete="off" onsubmit="event.target.onsubmit = preventDefault" class="w-100 d-flex justify-content-center">
      <input type="hidden" name="AuthState" value="{{ (stateparams.AuthState??'')|e }}"/>

      {% if csrf_token is defined %}
        <input type="hidden" name="csrf-token" value="{{ csrf_token|e }}"/>
      {% endif %}

      <div class="card idp-card shadow-lg border-0 rounded-3">
        <div class="card-header bg-white text-center border-0 pt-4 pb-2">
          <img src="/logo.png" alt="{{ '{login:logo}'|trans({'%idpName%': idp_name}) }}" class="img-fluid" style="max-width:150px;">
          <h1 class="h3 card-title text-body mt-3 mb-0">
            {{ '{login:header}'|trans({'%idpName%': idp_name}) }}
          </h1>
        </div>

        <div class="card-body p-4">
          <div class="form-floating mb-3">
            <input
              type="text"
              required
              name="username"
              class="form-control"
              value="{{ username|e }}"
              {% if username is empty %} autofocus {% endif %}
              id="username"
              placeholder="{{ '{login:label_username}'|trans }}"
            >
            <label for="username">{{ '{login:label_username}'|trans }}</label>
          </div>

          <div class="input-group mb-3">
            <div class="form-floating flex-grow-1">
              <input
                type="password"
                required
                name="password"
                class="form-control"
                {% if username is not empty %} autofocus {% endif %}
                id="password"
                placeholder="{{ '{login:label_password}'|trans }}"
              >
              <label for="password">{{ '{login:label_password}'|trans }}</label>
            </div>
            <button
              type="button"
              class="btn btn-secondary d-flex align-items-center"
              onclick="togglePasswordVisibility()"
              aria-label="{{ '{login:show_password}'|trans|e }}"
              aria-pressed="false"
              id="password-visibility-toggle"
            >
              <i class="material-icons" aria-hidden="true">visibility</i>
            </button>
          </div>
        </div>

        {% if errorcode ?? '' == 'WRONGUSERPASS' %}
          {% set errorMessageKey = errorparams[1] ?? '{login:error_wronguserpass}' %}
          {% set errorMessageTokens = errorparams[2] ?? null %}
          {% set message = errorMessageKey|trans(errorMessageTokens) %}
          <div class="alert alert-danger d-flex align-items-center mx-4 mb-3" role="alert">
            <i class="material-icons me-2">error</i>
            <div>{{ message|e }}</div>
          </div>

          {% if analytics_tracking_id is not empty %}
            <script>
              gtag('event', '{{ errorcode|e('js') }}', {
                'event_category': 'error',
                'event_label': 'message',
                'value': '{{ message|e('js') }}'
              });
            </script>
          {% endif %}
        {% endif %}

        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center p-3">
          {% if password_forgot_url is not empty %}
            <button
              type="button"
              onclick="forgotPassword()"
              class="btn btn-outline-primary"
            >
              {{ '{login:forgot}'|trans }}
            </button>
          {% endif %}

          <span class="flex-grow-1"></span>

          <button class="btn btn-primary" id="submit-button">
            {{ '{login:button_login}'|trans }}
          </button>
        </div>

        {% if (help_center_url is defined and help_center_url is not empty) or (profile_url is defined and profile_url is not empty) %}
          <div class="d-flex justify-content-around p-3 border-top mt-auto">
            {% if help_center_url is defined and help_center_url is not empty %}
              <a
                href="{{ help_center_url }}"
                target="_blank"
                rel="noopener"
                class="btn btn-link text-decoration-none d-inline-flex align-items-center"
              >
                {{ '{login:help}'|trans }}
                <i class="material-icons ms-1" style="font-size: 18px;">launch</i>
              </a>
            {% endif %}

            {% if profile_url is defined and profile_url is not empty %}
              <a
                href="{{ profile_url }}"
                target="_blank"
                rel="noopener"
                class="btn btn-link text-decoration-none d-inline-flex align-items-center"
              >
                {{ '{login:profile}'|trans }}
                <i class="material-icons ms-1" style="font-size: 18px;">launch</i>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </form>
  </main>
</div>
</body>
</html>
