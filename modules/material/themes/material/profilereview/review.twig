<!DOCTYPE html>
<html lang="{{ currentLanguage }}">
<head>
  <title>{{ '{review:title}'|trans }}</title>

  {{ include('header.twig') }}

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      function prettifyDates() {
        const relevantNodes = Array.from(document.querySelectorAll('.item-text-body'))

        relevantNodes.filter(hasDate).map(replaceWithLocaleDate)
      }

      const hasDate = node => node.innerText.includes('Z')
      const replaceWithLocaleDate = node => {
        const matches = node.innerText.match(/(.*: )(.*)/)
        if (!matches) return;
        const label = matches[1]
        const date = new Date(matches[2])

        node.innerText = `${label} ${date.toLocaleDateString()} ${date.toLocaleTimeString()}`
      }

      prettifyDates();

      document.getElementById('launch').addEventListener('click', function(e) {
        const continueBtn = document.querySelector('[name=continue]');
        if (continueBtn) {
          continueBtn.click();
        }
      });
    });
  </script>
</head>
<body class="gradient-bg d-flex flex-column min-vh-100">
<div class="bootstrap-layout container-fluid p-0 d-flex flex-column flex-grow-1 min-vh-100">
  <header class="navbar navbar-expand-lg bg-primary navbar-dark px-3 py-2 shadow-sm">
    <div class="container-fluid">
      <span class="navbar-brand mb-0 h1 text-wrap me-auto">
        {{ '{review:header}'|trans }}
      </span>
    </div>
  </header>

  <main class="container d-flex flex-column align-items-center justify-content-center flex-grow-1 my-auto">
    <form method="post" class="w-75 d-flex flex-column align-items-center gap-4">
      <h2 class="h2 text-center text-body my-3">
        {{ '{review:info}'|trans }}
      </h2>

      <div class="row justify-content-center g-4 w-100 mb-3">
        {% if mfa_options|length > 0 %}
          <div class="col-12 col-md-6 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3 h-100">
              <div class="card-header bg-white text-center border-0 pt-4 pb-2">
                <h1 class="h4 card-title text-body mb-0">
                  {{ '{review:mfa_header}'|trans({'%idpName%': idp_name}) }}
                </h1>
              </div>

              <div class="card-body">
                <ul class="list-group list-group-flush">
                  {% for mfa in mfa_options %}
                    <li class="list-group-item d-flex align-items-start border-0 px-0 py-2">
                      <img class="me-3" src="mfa-{{ mfa.type }}.svg" width="32" height="32" alt="{{ mfa.type }}">

                      <div>
                        <div class="fw-semibold text-body">
                          {{ mfa.label is not empty ? mfa.label : mfa.data.label }}
                          {% if mfa.type == 'backupcode' %}
                            {{ '{review:remaining}'|trans({'%count%': mfa.data.count|default(0)}) }}
                          {% elseif mfa.type == 'webauthn' %}
                            {% set count = mfa.count is defined ? mfa.count : (mfa.data is defined and mfa.data ? 1 : 0) %}
                            {{ '{review:available}'|trans({'%count%': count}) }}
                          {% endif %}
                        </div>

                        <small class="text-secondary item-text-body d-block">
                          {% if mfa.last_used_utc is empty %}
                            {{ '{review:used_never}'|trans }}
                          {% else %}
                            {{ '{review:used}'|trans({'%when%': mfa.last_used_utc}) }}
                          {% endif %}
                        </small>
                      </div>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          </div>
        {% endif %}

        {% if method_options|length > 0 %}
          <div class="col-12 col-md-6 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3 h-100">
              <div class="card-header bg-white text-center border-0 pt-4 pb-2">
                <h1 class="h4 card-title text-body mb-0">
                  {{ '{review:methods_header}'|trans }}
                </h1>
              </div>

              <div class="card-body">
                <ul class="list-group list-group-flush">
                  {% for method in method_options %}
                    <li class="list-group-item d-flex align-items-start border-0 px-0 py-2">
                      <img class="me-3" src="email.svg" width="32" height="32" alt="email">

                      <div>
                        <div class="fw-semibold text-body">
                          {{ method.value }}
                        </div>

                        <small class="text-secondary d-block">
                          {% set key = '{review:' ~ (method.verified ? 'verified' : 'unverified') ~ '}' %}
                          {{ key|trans }}
                        </small>
                      </div>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          </div>
        {% endif %}
      </div>

      <div class="d-flex flex-wrap justify-content-center align-items-center gap-3 mt-3">
        <a id="launch" href="{{ profile_url }}" target="_blank" rel="noopener" class="btn btn-outline-primary d-inline-flex align-items-center">
          {{ '{review:button_update}'|trans }} <i class="material-icons ms-1" style="font-size: 18px;">launch</i>
        </a>

        <button name="continue" class="btn btn-primary">
          {{ '{review:button_continue}'|trans }}
        </button>
      </div>
    </form>
  </main>
    {{ include('footer.twig') }}
</div>
</body>
</html>
