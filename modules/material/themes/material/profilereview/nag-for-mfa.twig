<!DOCTYPE html>
<html lang="{{ currentLanguage }}">
<head>
  <title>{{ '{nag:mfa_title}'|trans }}</title>

  {{ include('header.twig') }}
</head>
<body class="gradient-bg d-flex flex-column min-vh-100">
<div class="bootstrap-layout container-fluid p-0 d-flex flex-column flex-grow-1 min-vh-100">
  <header class="navbar navbar-expand-lg bg-primary navbar-dark px-3 py-2 shadow-sm">
    <div class="container-fluid">
      <span class="navbar-brand mb-0 h1 text-wrap me-auto">
        {{ '{nag:mfa_header}'|trans }}
      </span>
    </div>
  </header>

  <main class="container d-flex flex-column align-items-center justify-content-center flex-grow-1 my-auto py-4">
    <form method="post" class="w-100 d-flex justify-content-center">
      <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-white text-center border-0 pt-4 pb-2">
          <img src="shield.svg" alt="{{ '{nag:shield_icon}'|trans }}" style="height: 100px;">
          <h1 class="h3 card-title text-body mt-3 mb-0">
            {{ '{nag:header}'|trans }}
          </h1>
        </div>

        <div class="card-body text-center px-4 py-2">
          <p class="card-text text-secondary mb-5 lh-lg">
            {{ '{nag:mfa_info}'|trans }}
          </p>
          <p class="card-text text-secondary mb-3">
            {{ '{nag:reauth_notice}'|trans }}
          </p>
        </div>

        <div class="card-footer bg-transparent border-top-0 d-flex flex-wrap justify-content-between align-items-center gap-2 p-3">
          <button name="continue" type="submit" class="btn btn-outline-secondary">
            {{ '{nag:button_later}'|trans }}
          </button>

          <span class="flex-grow-1"></span>

          {% if mfa_learn_more_url is not empty %}
            <a
              href="{{ mfa_learn_more_url }}"
              target="_blank"
              rel="noopener"
              class="btn btn-outline-primary"
            >
              {{ '{nag:button_learn_more}'|trans }}
            </a>
          {% endif %}

          <button name="update" class="btn btn-primary">
            {{ '{nag:button_enable}'|trans }}
          </button>
        </div>
      </div>
    </form>
  </main>
</div>
</body>
</html>
